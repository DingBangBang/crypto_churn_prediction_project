# -----------------------------------------------------------------------------
# 复制为 environment.env 并填入真实值（environment.env 已被 .gitignore 忽略）
# -----------------------------------------------------------------------------
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# 抓取地址数量上限：200 = 测试模式（产物带 _test 后缀）；2000 = 本机验证规模。
# 全量约 12000 个活跃节点，本机免费 Key 跑不动/会超时，需公司内部 Etherscan API。
ADDRESS_LIMIT=200
CHAIN_ID=1
MONTHS_BACK=6
CHURN_DAYS=30

# ---- 预测窗口与风险等级 ----
FORECAST_HORIZON_DAYS=30          # 主窗口（图表/阈值口径）
FORECAST_HORIZONS=1,7,14,30,90    # 一次 ARIMA 拟合同时输出的多时间窗
RISK_CRITICAL_MULTIPLIER=1.5      # ≥1.5× 阈值 → 🔴 高危（必须立刻重视）
RISK_ALERT_MULTIPLIER=1.0         # ≥1.0× 阈值 → 🟠 警戒
RISK_WATCH_MULTIPLIER=0.75        # ≥0.75× 阈值 → 🟡 关注，否则 🟢 正常

# ---- 链接 / 入口 ----
DASHBOARD_URL=http://localhost:8501
ETHERSCAN_BASE_URL=https://api.etherscan.io/v2/api
GMAIL_API_SEND_URL=https://gmail.googleapis.com/gmail/v1/users/me/messages/send
GMAIL_OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token
GMAIL_OAUTH_DEVICE_URL=https://oauth2.googleapis.com/device/code

# ---- 邮件预警 ----
# 方案 A（推荐）：Gmail API + OAuth2 —— Google 已下线「应用专用密码」。
# 在 Google Cloud Console 创建 OAuth 客户端（类型：桌面应用），填入前两项后执行
#   python -m src.notify --oauth-login
# 一次性授权后会自动打印 GMAIL_REFRESH_TOKEN。
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# 方案 B：SMTP + 应用专用密码（仅在账号仍可用时）
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=dingbangchu@gmail.com
SMTP_PASS=your_gmail_app_password

# 国内/受限网络下 SMTP 出站会被阻断（TCP 可连但 TLS 握手挂死）；
# 填本地代理后邮件改走代理隧道 / HTTPS API。示例：
# NET_PROXY=http://127.0.0.1:7897
NET_PROXY=
SMTP_PROXY=
ALERT_EMAIL_TO=dingbangchu@gmail.com

# ---- Lark（飞书 / Lark）预警 ----
# 机器人每天推送：流失预警 + 用户行为聚类结果（文字描述）+ 自动提炼的 insights
LARK_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx
# @ 只能填 Lark open_id（ou_ 开头）；手机号无法 @，留空即不 @
LARK_AT_PHONE=

# ---- 预警阈值 ----
ALERT_CHURN_RATE_THRESHOLD=0.40
ALERT_RISK_CLUSTER_RATIO=0.25
